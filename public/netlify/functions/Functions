import { getStore } from "@netlify/blobs";
import { timingSafeEqual } from "node:crypto";

function samePassword(a, b) {
  const A = Buffer.from(String(a ?? ""));
  const B = Buffer.from(String(b ?? ""));
  return A.length === B.length && timingSafeEqual(A, B);
}

export default async (req) => {
  const store = getStore("casa-caribe");

  if (req.method === "GET") {
    const data = await store.get("content", { type: "json" });
    return Response.json(data ?? null, { headers: { "Cache-Control": "no-store" } });
  }

  if (req.method === "POST") {
    const adminPassword = process.env.ADMIN_PASSWORD;
    if (!adminPassword) {
      return new Response("ADMIN_PASSWORD fehlt in Netlify", { status: 500 });
    }
    let body;
    try {
      body = await req.json();
    } catch {
      return new Response("Ungültige Anfrage", { status: 400 });
    }
    if (!samePassword(body.password, adminPassword)) {
      return new Response("Falsches Passwort", { status: 401 });
    }
    if (body.check) return Response.json({ ok: true });

    const content = body.content;
    if (!content || typeof content !== "object" || JSON.stringify(content).length > 4_000_000) {
      return new Response("Ungültige Daten", { status: 400 });
    }
    await store.setJSON("content", content);
    return Response.json({ ok: true });
  }

  return new Response("Nicht erlaubt", { status: 405 });
};

export const config = { path: "/api/content" };
