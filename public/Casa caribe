<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Casa Caribe – Cocktails</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lilita+One&family=Nunito:wght@400;700;800&family=Caveat:wght@700&display=swap" rel="stylesheet">
<style>
:root{--lagoon:#0B5D6B;--turq:#19B5B0;--coral:#FF6B57;--sun:#FFC93C;--sand:#FFF4DC;--ink:#12343B}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:Nunito,system-ui,sans-serif;background:var(--sand);color:var(--ink);line-height:1.5}
[data-key]{outline:none}
.hero{background:linear-gradient(170deg,var(--lagoon),var(--turq));color:#fff;padding:3.5rem 1.25rem 6rem;text-align:center;position:relative;overflow:hidden}
.hero::before{content:"";position:absolute;width:11rem;height:11rem;border-radius:50%;background:var(--sun);right:-3rem;top:-3rem;opacity:.95}
.hero::after{content:"";position:absolute;left:0;right:0;bottom:-1px;height:3.5rem;background:var(--sand);border-radius:60% 40% 0 0/100% 100% 0 0}
.logo{font-family:"Lilita One",cursive;font-size:1.3rem;position:relative}
.hero h1{font-family:"Lilita One",cursive;font-weight:400;font-size:calc(var(--s,1)*clamp(2.6rem,10vw,4.8rem));line-height:1.05;margin:1.5rem 0 .75rem;position:relative}
.hero p{font-size:calc(var(--s,1)*1.2rem);max-width:30rem;margin:0 auto 1.75rem;position:relative}
.btn{display:inline-block;background:var(--coral);color:#fff;font-weight:800;font-size:1.05rem;padding:.85rem 1.8rem;border-radius:2rem;text-decoration:none;border:0;cursor:pointer;position:relative;font-family:inherit}
.wrap{max-width:62rem;margin:0 auto;padding:0 1.25rem}
.why{background:#fff;border-left:.5rem solid var(--sun);border-radius:.5rem 2rem 2rem .5rem;padding:1.4rem 1.5rem;margin:-1.5rem auto 3rem;max-width:40rem;position:relative;z-index:1;box-shadow:0 .5rem 1.5rem rgba(11,93,107,.12)}
.why h2{font-family:"Lilita One",cursive;font-weight:400;color:var(--lagoon);font-size:calc(var(--s,1)*1.5rem);margin:0 0 .4rem}
.why p{margin:0;font-size:calc(var(--s,1)*1rem)}
#karte{scroll-margin-top:1rem;padding:.9rem;border-radius:1.2rem;background:repeating-linear-gradient(90deg,#a2733c 0 3.2rem,#7a4d22 3.2rem 3.35rem,#946530 3.35rem 6.6rem,#7a4d22 6.6rem 6.75rem);box-shadow:0 .7rem 1.6rem rgba(0,0,0,.3)}
.board{background:#17454d;border-radius:.6rem;padding:1.8rem 1.2rem 1.4rem;box-shadow:inset 0 0 2.5rem rgba(0,0,0,.45);background-image:radial-gradient(rgba(255,255,255,.06) 1px,transparent 1px);background-size:5px 5px;color:#fff}
#karte h2{font-family:"Lilita One",cursive;font-weight:400;color:var(--sun);font-size:calc(var(--s,1)*2.4rem);margin:0;text-align:center}
.title{display:flex;align-items:center;justify-content:center;gap:.6rem}
.title::before,.title::after{content:"🌴";font-size:1.8rem}
.note{font-family:Caveat,cursive;font-size:calc(var(--s,1)*1.3rem);color:#cfeeea;margin:.2rem 0 1.2rem;text-align:center}
.grid{display:block}
.card{display:grid;grid-template-columns:4.5rem 1fr;gap:1rem;align-items:center;padding:1rem 0;border-bottom:2px dashed rgba(255,255,255,.25);position:relative}
.card:last-child{border-bottom:0}
.pic{width:4.5rem;height:4.5rem;border-radius:50%;border:3px solid var(--sun);background:linear-gradient(135deg,var(--sun),var(--coral)) center/cover;display:flex;align-items:center;justify-content:center;font-size:2rem}
.line{display:flex;align-items:baseline;gap:.5rem}
.dots{flex:1;min-width:1rem;border-bottom:3px dotted rgba(255,255,255,.4);transform:translateY(-.3rem)}
.card h3{font-family:"Lilita One",cursive;font-weight:400;font-size:calc(var(--s,1)*1.5rem);margin:0;color:#fff}
.card .price{font-family:"Lilita One",cursive;font-size:calc(var(--s,1)*1.4rem);color:var(--sun);white-space:nowrap}
.card .desc{font-family:Caveat,cursive;font-size:calc(var(--s,1)*1.3rem);line-height:1.2;color:#cfeeea;margin:.15rem 0 0}
footer{text-align:center;padding:3rem 1rem 6rem;color:var(--lagoon);font-size:.9rem}
footer a{color:inherit;opacity:.45;text-decoration:none;margin-left:.6rem;cursor:pointer}
/* Bearbeiten-Modus */
.editonly{display:none}
body.editing .editonly{display:block}
body.editing [data-key]{outline:2px dashed var(--turq);outline-offset:3px;border-radius:.3rem;min-height:1em}
body.editing [data-key]:focus{outline-color:var(--coral);background:rgba(255,201,60,.18)}
body.editing .pic{cursor:pointer;position:relative}
body.editing .pic::after{content:"📷";position:absolute;bottom:-.2rem;right:-.2rem;background:#fff;border-radius:50%;width:1.6rem;height:1.6rem;font-size:.9rem;display:flex;align-items:center;justify-content:center}
.del{position:absolute;top:.2rem;right:0;background:#c0392b;color:#fff;border:0;border-radius:1rem;padding:.3rem .8rem;font:700 .85rem Nunito,sans-serif;cursor:pointer;z-index:2}
.add{margin:1.5rem auto 0;text-align:center}
.add .btn{display:inline-block}
#bar{position:fixed;left:0;right:0;bottom:0;background:var(--ink);color:#fff;padding:.6rem .8rem calc(.6rem + env(safe-area-inset-bottom,0px));display:none;gap:.5rem;align-items:center;flex-wrap:wrap;justify-content:center;z-index:20}
body.editing #bar{display:flex}
#bar button{font:700 .95rem Nunito,sans-serif;border:0;border-radius:.6rem;padding:.55rem .9rem;background:#fff;color:var(--ink);cursor:pointer}
#bar .save{background:var(--sun)}
#bar .end{background:transparent;color:#fff;border:1px solid #fff}
dialog{border:0;border-radius:1.2rem;padding:1.5rem;max-width:20rem;width:90%}
dialog input{width:100%;font:1rem Nunito,sans-serif;padding:.7rem;border:2px solid var(--turq);border-radius:.6rem;margin:.6rem 0}
dialog .row{display:flex;gap:.5rem;justify-content:flex-end}
dialog button{font:700 1rem Nunito,sans-serif;border:0;border-radius:.6rem;padding:.6rem 1rem;cursor:pointer}
#err{color:#c0392b;min-height:1.3em;margin:0;font-size:.9rem}
#toast{position:fixed;left:50%;top:1rem;transform:translateX(-50%);background:var(--lagoon);color:#fff;padding:.7rem 1.2rem;border-radius:2rem;font-weight:700;display:none;z-index:30;max-width:90%;text-align:center}
</style>
</head>
<body>
<header class="hero">
  <div class="logo">Casa Caribe</div>
  <h1 data-key="heroTitle" data-single></h1>
  <p data-key="heroSub"></p>
  <a class="btn" href="#karte">Zur Karte</a>
</header>

<main class="wrap">
  <section class="why">
    <h2 data-key="whyTitle" data-single></h2>
    <p data-key="whyText"></p>
  </section>

  <section id="karte">
   <div class="board">
    <div class="title"><h2 data-key="menuTitle" data-single></h2></div>
    <p class="note" data-key="menuNote" data-single></p>
    <div class="grid" id="grid"></div>
    <div class="add editonly"><button class="btn" id="addBtn">+ Cocktail hinzufügen</button></div>
   </div>
  </section>
</main>

<footer>Casa Caribe<a id="adminLink">Anmelden</a></footer>

<div id="bar">
  <span>Schrift:</span>
  <button id="smaller">A−</button><button id="bigger">A+</button><button id="bold">Fett</button>
  <button class="save" id="save">Speichern</button>
  <button class="end" id="end">Beenden</button>
</div>

<dialog id="login">
  <form method="dialog" id="loginForm">
    <strong>Anmelden zum Bearbeiten</strong>
    <input type="password" id="pw" placeholder="Passwort" autocomplete="current-password">
    <p id="err"></p>
    <div class="row">
      <button type="button" id="cancel">Abbrechen</button>
      <button type="submit" class="btn" style="background:var(--coral);color:#fff">Anmelden</button>
    </div>
  </form>
</dialog>
<input type="file" id="file" accept="image/*" hidden>
<div id="toast"></div>

<script>
const DEFAULT = {
  texts: {
    heroTitle: "Karibik im Glas",
    heroSub: "Frisch gemixte Cocktails mit Rum, Früchten und Sonne.",
    whyTitle: "Warum wir Cocktails verkaufen",
    whyText: "Weil ein guter Cocktail den Urlaub nach Hause bringt. Wir mixen mit frischen Früchten und fairen Preisen, damit jeder Tag ein kleines Stück Karibik bekommt.",
    menuTitle: "Unsere Cocktails",
    menuNote: "Preise inkl. MwSt."
  },
  styles: {},
  cocktails: [
    {id:"a1",name:"Piña Colada",desc:"Rum, Kokosmilch und Ananas – cremig und tropisch.",price:"7,50 €",img:""},
    {id:"a2",name:"Mojito",desc:"Weißer Rum, frische Minze, Limette und Soda.",price:"7,00 €",img:""},
    {id:"a3",name:"Caipirinha",desc:"Cachaça, Limette und Rohrzucker auf Eis.",price:"6,50 €",img:""},
    {id:"a4",name:"Blue Lagoon",desc:"Wodka, Blue Curaçao und Zitronenlimonade.",price:"6,50 €",img:""},
    {id:"a5",name:"Planter’s Punch",desc:"Dunkler Rum, Orange, Ananas und Grenadine.",price:"7,50 €",img:""}
  ]
};

let data = structuredClone(DEFAULT);
let editing = false, password = "", dirty = false, current = null, picId = null;
const $ = s => document.querySelector(s);

function toast(msg){const t=$("#toast");t.textContent=msg;t.style.display="block";clearTimeout(toast.t);toast.t=setTimeout(()=>t.style.display="none",3500)}

function getText(key){
  if(key.startsWith("c:")){const [,id,f]=key.split(":");const c=data.cocktails.find(x=>x.id===id);return c?c[f]:""}
  return data.texts[key] ?? "";
}
function setText(key,val){
  if(key.startsWith("c:")){const [,id,f]=key.split(":");const c=data.cocktails.find(x=>x.id===id);if(c)c[f]=val}
  else data.texts[key]=val;
}
function applyStyle(el){
  const s=data.styles[el.dataset.key]||{};
  if(s.scale&&s.scale!==1)el.style.setProperty("--s",s.scale);else el.style.removeProperty("--s");
  el.style.fontWeight=s.bold===true?"800":s.bold===false?"400":"";
}
function bind(el){
  el.textContent=getText(el.dataset.key);
  applyStyle(el);
  el.addEventListener("focus",()=>current=el);
  el.addEventListener("input",()=>{setText(el.dataset.key,el.innerText.trim());dirty=true});
  el.addEventListener("keydown",e=>{if(e.key==="Enter"&&el.hasAttribute("data-single"))e.preventDefault()});
  el.addEventListener("paste",e=>{e.preventDefault();document.execCommand("insertText",false,(e.clipboardData||window.clipboardData).getData("text/plain").replace(/\s*\n\s*/g," "))});
  setEditable(el);
}
function setEditable(el){
  if(!editing){el.removeAttribute("contenteditable");return}
  el.contentEditable="plaintext-only";
  if(el.contentEditable!=="plaintext-only")el.contentEditable="true";
}

function renderGrid(){
  const grid=$("#grid");grid.innerHTML="";
  data.cocktails.forEach(c=>{
    const card=document.createElement("article");card.className="card";
    const del=document.createElement("button");del.className="del editonly";del.textContent="Löschen";
    del.onclick=()=>{if(confirm("„"+(c.name||"Cocktail")+"“ löschen?")){data.cocktails=data.cocktails.filter(x=>x.id!==c.id);dirty=true;renderGrid()}};
    const pic=document.createElement("div");pic.className="pic";
    if(c.img)pic.style.backgroundImage=`url("${c.img}")`;else pic.textContent="🍹";
    pic.onclick=()=>{if(editing){picId=c.id;$("#file").click()}};
    const body=document.createElement("div");body.className="body";
    const mk=(tag,f,cls,single)=>{const el=document.createElement(tag);if(cls)el.className=cls;el.dataset.key=`c:${c.id}:${f}`;if(single)el.setAttribute("data-single","");return el};
    const line=document.createElement("div");line.className="line";
    line.append(mk("h3","name","",true),Object.assign(document.createElement("i"),{className:"dots"}),mk("div","price","price",true));
    body.append(line,mk("p","desc","desc",false));
    card.append(del,pic,body);grid.appendChild(card);
    body.querySelectorAll("[data-key]").forEach(bind);
  });
}
function render(){
  document.querySelectorAll("main [data-key]:not(#grid [data-key]), .hero [data-key]").forEach(bind);
  renderGrid();
}

async function load(){
  try{
    const r=await fetch("/api/content",{cache:"no-store"});
    if(r.ok){
      const d=await r.json();
      if(d)data={texts:{...DEFAULT.texts,...(d.texts||{})},styles:d.styles||{},cocktails:Array.isArray(d.cocktails)?d.cocktails:DEFAULT.cocktails};
    }
  }catch(e){}
  render();
}

function setEditing(on){
  editing=on;document.body.classList.toggle("editing",on);
  document.querySelectorAll("[data-key]").forEach(setEditable);
}

/* Anmelden */
$("#adminLink").onclick=()=>{$("#err").textContent="";$("#pw").value="";$("#login").showModal();$("#pw").focus()};
$("#cancel").onclick=()=>$("#login").close();
$("#loginForm").addEventListener("submit",async e=>{
  e.preventDefault();
  const pw=$("#pw").value;
  try{
    const r=await fetch("/api/content",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({password:pw,check:true})});
    if(r.ok){password=pw;$("#login").close();setEditing(true);toast("Bearbeiten-Modus an. Texte antippen und ändern.")}
    else if(r.status===401)$("#err").textContent="Falsches Passwort.";
    else $("#err").textContent="Server-Fehler: "+(await r.text());
  }catch(err){$("#err").textContent="Server nicht erreichbar."}
});

/* Schrift */
document.querySelectorAll("#bar button").forEach(b=>b.addEventListener("pointerdown",e=>e.preventDefault()));
function style(){if(!current)return null;const k=current.dataset.key;return data.styles[k]=data.styles[k]||{}}
$("#bigger").onclick=()=>{const s=style();if(!s)return toast("Erst einen Text antippen.");s.scale=Math.min(2.5,+((s.scale||1)+.1).toFixed(2));applyStyle(current);dirty=true};
$("#smaller").onclick=()=>{const s=style();if(!s)return toast("Erst einen Text antippen.");s.scale=Math.max(.6,+((s.scale||1)-.1).toFixed(2));applyStyle(current);dirty=true};
$("#bold").onclick=()=>{const s=style();if(!s)return toast("Erst einen Text antippen.");const w=+getComputedStyle(current).fontWeight;s.bold=!(w>=600);applyStyle(current);dirty=true};

/* Cocktails & Fotos */
$("#addBtn").onclick=()=>{data.cocktails.push({id:Date.now().toString(36),name:"Neuer Cocktail",desc:"Beschreibung",price:"0,00 €",img:""});dirty=true;renderGrid()};
$("#file").onchange=async e=>{
  const f=e.target.files[0];e.target.value="";if(!f||!picId)return;
  const url=await shrink(f,800);const c=data.cocktails.find(x=>x.id===picId);
  if(c){c.img=url;dirty=true;renderGrid()}
};
function shrink(file,max){
  return new Promise(res=>{
    const img=new Image();img.onload=()=>{
      const k=Math.min(1,max/Math.max(img.width,img.height));
      const cv=document.createElement("canvas");cv.width=img.width*k;cv.height=img.height*k;
      cv.getContext("2d").drawImage(img,0,0,cv.width,cv.height);res(cv.toDataURL("image/jpeg",.82));
    };img.src=URL.createObjectURL(file);
  });
}

/* Speichern */
$("#save").onclick=async()=>{
  try{
    const r=await fetch("/api/content",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({password,content:data})});
    if(r.ok){dirty=false;toast("Gespeichert. Alle Besucher sehen jetzt die neue Version.")}
    else toast(r.status===401?"Falsches Passwort.":"Speichern fehlgeschlagen.");
  }catch(err){toast("Server nicht erreichbar.")}
};
$("#end").onclick=()=>{if(dirty&&!confirm("Es gibt ungespeicherte Änderungen. Trotzdem beenden?"))return;password="";setEditing(false);if(dirty){dirty=false;load()}};
addEventListener("beforeunload",e=>{if(dirty){e.preventDefault();e.returnValue=""}});

load();
</script>
</body>
</html>
